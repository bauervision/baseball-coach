# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-emulator/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

service-account.json

*.psd
# firebase emulators
*-debug.log

# private agent working artifacts (reports, screenshots, logs, notes) — not product docs
/.agent/
/agent-reports/
/test-results/
/screenshots/
# migration working files (inventories, plans, manifests, rollback files,
# verification reports, exports) hold child data; the tool refuses to write
# them inside the repo — these patterns are a second line of defence
/migration/
/migration-reports/
tallies-d1-*.json
*inventory*.json
*-plan.json
plan*.json
*rollback*.json
*verify*.json
*export*.json
*.json.sha256
