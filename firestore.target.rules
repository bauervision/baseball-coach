rules_version = '2';
// TARGET multi-coach ruleset (docs/MULTI_COACH_ARCHITECTURE.md,
// docs/PUBLIC_PRIVATE_DATA.md). NOT deployed; firebase.json still deploys
// firestore.rules. Tested by tests/emulator/targetRules.test.mjs.
//
// Model: approved coaches (coaches/{uid}, created by invitation binding in
// a later checkpoint) own teams and seasons through an immutable ownerUid.
// Anonymous visitors read only published seasons and their public
// subcollections; private fields live in */private/* docs (owner only).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function coachPath() { return /databases/$(database)/documents/coaches/$(request.auth.uid); }
    function isCoach() {
      return signedIn() && exists(coachPath()) && get(coachPath()).data.get('status', '') == 'active';
    }

    function seasonPath(id) { return /databases/$(database)/documents/seasons/$(id); }
    function teamPath(id) { return /databases/$(database)/documents/teams/$(id); }
    function auditPath(id) { return /databases/$(database)/documents/seasons/$(id)/private/audit; }

    function statusBefore(id) { return exists(seasonPath(id)) ? get(seasonPath(id)).data.get('status', '') : ''; }
    function statusAfter(id) { return existsAfter(seasonPath(id)) ? getAfter(seasonPath(id)).data.get('status', '') : ''; }

    function ownsSeason(id) {
      return isCoach() && exists(seasonPath(id)) && get(seasonPath(id)).data.get('ownerUid', '') == uid();
    }
    function ownsSeasonAfter(id) {
      return isCoach() && existsAfter(seasonPath(id)) && getAfter(seasonPath(id)).data.get('ownerUid', '') == uid();
    }
    // Published seasons are never draft/deleting (enforced on write).
    function publishedSeason(id) {
      return exists(seasonPath(id)) && get(seasonPath(id)).data.get('published', false) == true;
    }
    function seasonOpen(id) { return statusBefore(id) != 'finalized' && statusAfter(id) != 'finalized'; }
    function rosterWritable(id) {
      return seasonOpen(id) && statusBefore(id) != 'deleting' && statusAfter(id) != 'deleting';
    }
    function acceptsRecords(id) {
      return seasonOpen(id) && !(statusBefore(id) in ['draft', 'deleting'])
          && !(statusAfter(id) in ['draft', 'deleting']);
    }

    // Fields that must never appear in publicly readable documents.
    function playerPrivateKeys() {
      return ['shirtSize', 'careerPlayerId', 'identityStatus', 'identityMigration', 'linkedFrom'];
    }
    function seasonPrivateKeys() {
      return ['lifecycleHistory', 'finalizedByUid', 'reopenedByUid', 'coachUids'];
    }

    // ------------------------------------------------------------------
    // Coaches, workspaces, invitations: no client writes until invitation
    // binding is implemented (Checkpoint B). A coach reads only their own.
    // ------------------------------------------------------------------
    match /coaches/{coachUid} {
      allow read: if signedIn() && uid() == coachUid;
      allow write: if false;
    }
    match /coachWorkspaces/{workspaceId} {
      allow read: if isCoach() && resource.data.ownerUid == uid();
      allow write: if false;
    }
    match /coachInvites/{inviteId} {
      allow read, write: if false;
    }

    // Legacy allowlist and global config (old app only; never used for
    // team routing). Removal: when the v1.3.x app is retired.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{adminUid} {
      allow read: if signedIn() && uid() == adminUid;
      allow write: if false;
    }
    match /app/config {
      allow read: if true;
      allow create, update: if isAdmin() && isCoach() && (
        (resource != null
          && request.resource.data.get('currentSeasonId', null) == resource.data.get('currentSeasonId', null))
        || (ownsSeasonAfter(request.resource.data.get('currentSeasonId', ''))
            && !(statusAfter(request.resource.data.currentSeasonId) in ['draft', 'finalized', 'deleting']))
      );
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Player identities and linked children (unchanged model; coaches only).
    // ------------------------------------------------------------------
    match /playerIdentities/{playerId} {
      function identityKeys() {
        return ['careerPlayerId', 'displayName', 'managerUids', 'createdByUid', 'createdAt', 'updatedAt'];
      }
      allow get: if isCoach() && (resource == null || uid() in resource.data.managerUids);
      allow list: if isCoach() && uid() in resource.data.managerUids;
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(identityKeys())
        && request.resource.data.careerPlayerId == playerId
        && request.resource.data.managerUids == [uid()]
        && request.resource.data.createdByUid == uid()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80;
      allow update: if isCoach()
        && uid() in resource.data.managerUids
        && request.resource.data.keys().hasOnly(identityKeys())
        && request.resource.data.careerPlayerId == resource.data.careerPlayerId
        && request.resource.data.managerUids == resource.data.managerUids
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80;
      allow delete: if false;
    }

    match /coachProfiles/{profileUid}/linkedPlayers/{playerId} {
      function isOwner() { return isCoach() && uid() == profileUid; }
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['careerPlayerId', 'displayName', 'relationship', 'confirmed', 'linkedAt'])
        && request.resource.data.careerPlayerId == playerId
        && request.resource.data.relationship == 'child'
        && request.resource.data.confirmed == true
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
        && uid() in getAfter(/databases/$(database)/documents/playerIdentities/$(playerId)).data.managerUids;
      allow delete: if isOwner();
    }

    // ------------------------------------------------------------------
    // Teams (private) and their public projection.
    // ------------------------------------------------------------------
    function brandingSports() { return ['baseball', 'softball']; }
    function brandingLogoIds() { return ['tigers']; }
    function brandingCollections() { return ['original']; }
    function paletteKeys() {
      return ['bgBase', 'foreground', 'card', 'stroke', 'muted', 'primary', 'secondary', 'accent', 'accent2'];
    }
    function validColor(c) {
      return c is string && c.size() <= 48 && c.matches(
        '^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgba?[(] *[0-9]{1,3} *, *[0-9]{1,3} *, *[0-9]{1,3} *(, *(0|1|0?[.][0-9]+|1[.]0+) *)?[)])$');
    }
    function validPalette(p) {
      return p is map && p.keys().hasOnly(paletteKeys()) && p.keys().hasAll(paletteKeys())
          && validColor(p.bgBase) && validColor(p.foreground) && validColor(p.card)
          && validColor(p.stroke) && validColor(p.muted) && validColor(p.primary)
          && validColor(p.secondary) && validColor(p.accent) && validColor(p.accent2);
    }
    function validLogo(l) {
      return l == null || (l is map && l.keys().hasOnly(['kind', 'id']) && l.kind == 'bundled' && l.id in brandingLogoIds());
    }
    function validBrandingFields(b) {
      return b.teamName is string && b.teamName.size() > 0 && b.teamName.size() <= 40
          && b.shortName is string && b.shortName.size() <= 12
          && b.sport in brandingSports()
          && b.division is string && b.division.size() <= 40
          && validLogo(b.logo)
          && b.palettes is map && b.palettes.keys().hasOnly(['dark', 'light'])
          && validPalette(b.palettes.dark) && validPalette(b.palettes.light)
          && b.awardCollection in brandingCollections();
    }
    function teamKeys() {
      return ['teamId', 'teamName', 'shortName', 'sport', 'division', 'logo', 'palettes', 'awardCollection',
              'ownerUid', 'workspaceId', 'currentSeasonId', 'createdAt', 'updatedAt'];
    }
    // A team's current season: unchanged, or an existing season of this
    // team and owner that is not draft/finalized/deleting after the write
    // (drafts activate in the same transaction).
    function validTeamCurrentSeason(teamId) {
      let next = request.resource.data.get('currentSeasonId', null);
      return next == (resource == null ? null : resource.data.get('currentSeasonId', null))
          || (next is string && existsAfter(seasonPath(next))
              && getAfter(seasonPath(next)).data.get('teamId', '') == teamId
              && getAfter(seasonPath(next)).data.get('ownerUid', '') == uid()
              && !(getAfter(seasonPath(next)).data.get('status', '') in ['draft', 'finalized', 'deleting']));
    }

    match /teams/{teamId} {
      allow read: if isCoach() && resource.data.ownerUid == uid();
      allow create: if isCoach()
        && request.resource.data.keys().hasOnly(teamKeys())
        && request.resource.data.teamId == teamId
        && request.resource.data.ownerUid == uid()
        && request.resource.data.workspaceId == get(coachPath()).data.workspaceId
        && !('currentSeasonId' in request.resource.data)
        && validBrandingFields(request.resource.data);
      allow update: if isCoach() && resource.data.ownerUid == uid()
        && request.resource.data.keys().hasOnly(teamKeys())
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && validBrandingFields(request.resource.data)
        && validTeamCurrentSeason(teamId);
      allow delete: if false;
    }

    // Parent-facing team identity: only public branding fields and the
    // current season, kept equal to the private team doc (same batch).
    match /publicTeams/{teamId} {
      allow read: if true;
      allow create, update: if isCoach()
        && existsAfter(teamPath(teamId)) && getAfter(teamPath(teamId)).data.ownerUid == uid()
        && request.resource.data.keys().hasOnly(['teamName', 'shortName', 'sport', 'division', 'logo',
                                                 'palettes', 'awardCollection', 'currentSeasonId', 'updatedAt'])
        && validBrandingFields(request.resource.data)
        && request.resource.data.teamName == getAfter(teamPath(teamId)).data.teamName
        && request.resource.data.palettes == getAfter(teamPath(teamId)).data.palettes
        && request.resource.data.get('currentSeasonId', null) == getAfter(teamPath(teamId)).data.get('currentSeasonId', null)
        && (request.resource.data.get('currentSeasonId', null) == null
            || getAfter(seasonPath(request.resource.data.currentSeasonId)).data.get('published', false) == true);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Seasons.
    // ------------------------------------------------------------------
    function validSnapshot(data) {
      return !('branding' in data)
          || (data.branding is map
              && data.branding.keys().hasOnly(['teamId', 'teamName', 'shortName', 'sport', 'division', 'logo', 'palettes', 'awardCollection'])
              && validBrandingFields(data.branding)
              && data.branding.teamId == data.get('teamId', null));
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Lifecycle audit lives in seasons/{id}/private/audit, appended in the
    // same batch as the status change and attributed to the acting coach.
    function auditAppended(seasonId, action) {
      let before = exists(auditPath(seasonId)) ? get(auditPath(seasonId)).data.get('lifecycleHistory', []) : [];
      let after = existsAfter(auditPath(seasonId)) ? getAfter(auditPath(seasonId)).data.get('lifecycleHistory', []) : [];
      return after.size() == before.size() + 1
          && after[after.size() - 1].action == action
          && after[after.size() - 1].byUid == uid();
    }
    function isCurrentSomewhere(seasonId) {
      let teamId = resource.data.get('teamId', '');
      return (teamId != '' && exists(teamPath(teamId)) && get(teamPath(teamId)).data.get('currentSeasonId', '') == seasonId)
          || (exists(/databases/$(database)/documents/app/config)
              && get(/databases/$(database)/documents/app/config).data.get('currentSeasonId', '') == seasonId);
    }
    function seasonDocUnused(d) {
      let record = d.get('record', {});
      let awards = d.get('finalAwards', {});
      return d.get('endSeasonMode', false) != true && d.get('gamesPlayed', 0) == 0
          && d.get('recognitionLayouts', {}).size() == 0
          && record.get('wins', 0) == 0 && record.get('losses', 0) == 0 && record.get('ties', 0) == 0
          && awards.keys().hasOnly(['mvp', 'dominator', 'honorableMention', 'bestAllAround', 'bestAttitude'])
          && awards.get('mvp', '') == '' && awards.get('dominator', '') == '' && awards.get('honorableMention', '') == ''
          && awards.get('bestAllAround', '') == '' && awards.get('bestAttitude', '') == '';
    }
    function nextStatus() { return request.resource.data.get('status', ''); }
    function isActivation(seasonId) {
      return resource.data.get('status', '') == 'draft' && nextStatus() == 'active'
          && changedKeys().hasOnly(['status', 'activatedAt', 'updatedAt']) && auditAppended(seasonId, 'activated');
    }
    function isFinalization(seasonId) {
      return nextStatus() == 'finalized' && request.resource.data.get('published', false) == resource.data.get('published', false)
          && changedKeys().hasOnly(['status', 'finalizedAt', 'updatedAt']) && auditAppended(seasonId, 'finalized');
    }
    function isReopen(seasonId) {
      return nextStatus() == 'active'
          && changedKeys().hasOnly(['status', 'reopenedAt', 'updatedAt']) && auditAppended(seasonId, 'reopened');
    }
    function isDeletionLock(seasonId) {
      return resource.data.get('status', '') == 'draft' && nextStatus() == 'deleting'
          && changedKeys().hasOnly(['status', 'updatedAt']) && auditAppended(seasonId, 'deletionStarted')
          && resource.data.get('published', false) != true
          && !isCurrentSomewhere(seasonId) && seasonDocUnused(resource.data);
    }
    function isDeletionCancel(seasonId) {
      return nextStatus() == 'draft' && changedKeys().hasOnly(['status', 'updatedAt'])
          && auditAppended(seasonId, 'deletionCancelled');
    }
    // Publication is its own explicit change, independent of lifecycle,
    // but never for a draft or a season being deleted.
    function isPublicationChange() {
      return changedKeys().hasOnly(['published', 'updatedAt'])
          && request.resource.data.published is bool
          && !(request.resource.data.published == true && resource.data.get('status', '') in ['draft', 'deleting']);
    }
    function isOrdinaryEdit() {
      return !changedKeys().hasAny(['status', 'finalizedAt', 'reopenedAt', 'activatedAt', 'branding',
                                    'teamId', 'ownerUid', 'published']);
    }
    function matchesTeam(b, teamId) {
      let team = get(teamPath(teamId)).data;
      return b.teamName == team.teamName && b.shortName == team.shortName && b.sport == team.sport
          && b.division == team.division && b.logo == team.logo && b.palettes == team.palettes
          && b.awardCollection == team.awardCollection;
    }
    function isBrandingApply() {
      return changedKeys().hasOnly(['branding', 'teamName', 'league', 'updatedAt'])
          && 'branding' in request.resource.data && validSnapshot(request.resource.data)
          && matchesTeam(request.resource.data.branding, resource.data.teamId);
    }

    match /seasons/{seasonId} {
      // Rules are not filters: anonymous queries must ask for published ==
      // true; coach queries for ownerUid == their uid.
      allow read: if resource.data.published == true
                  || (isCoach() && resource.data.ownerUid == uid());
      allow create: if isCoach()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.teamId is string
        && exists(teamPath(request.resource.data.teamId))
        && get(teamPath(request.resource.data.teamId)).data.ownerUid == uid()
        && request.resource.data.get('status', 'draft') in ['draft', 'active']
        && request.resource.data.get('published', false) == false
        && !request.resource.data.keys().hasAny(seasonPrivateKeys())
        && validSnapshot(request.resource.data);
      allow update: if isCoach() && resource.data.ownerUid == uid()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('teamId', null) == resource.data.get('teamId', null)
        && !request.resource.data.keys().hasAny(seasonPrivateKeys())
        && (resource.data.get('status', '') == 'finalized'
              ? (isReopen(seasonId) || isPublicationChange())
              : resource.data.get('status', '') == 'deleting'
                ? isDeletionCancel(seasonId)
                : (isOrdinaryEdit() || isActivation(seasonId) || isFinalization(seasonId)
                   || isBrandingApply() || isDeletionLock(seasonId) || isPublicationChange()));
      allow delete: if isCoach() && resource.data.ownerUid == uid()
                    && resource.data.get('status', '') == 'deleting' && !isCurrentSomewhere(seasonId);

      // Season-level private docs (audit). Owner only; history append-only.
      match /private/{docId} {
        allow read: if ownsSeason(seasonId);
        allow create, update: if ownsSeasonAfter(seasonId)
          && request.resource.data.keys().hasOnly(['lifecycleHistory', 'finalizedByUid', 'reopenedByUid', 'coachUids', 'privacySplit'])
          && (resource == null
              || (request.resource.data.get('lifecycleHistory', []).size() >= resource.data.get('lifecycleHistory', []).size()
                  && (resource.data.get('lifecycleHistory', []).size() == 0
                      || request.resource.data.lifecycleHistory[0:resource.data.lifecycleHistory.size()] == resource.data.lifecycleHistory)));
        allow delete: if ownsSeason(seasonId) && statusBefore(seasonId) == 'deleting';
      }

      match /players/{playerId} {
        allow read: if ownsSeason(seasonId) || publishedSeason(seasonId);
        allow create, update: if ownsSeasonAfter(seasonId) && rosterWritable(seasonId)
          && !request.resource.data.keys().hasAny(playerPrivateKeys());
        allow delete: if ownsSeason(seasonId) && seasonOpen(seasonId);

        match /private/{docId} {
          allow read: if ownsSeason(seasonId);
          allow create, update: if ownsSeasonAfter(seasonId) && rosterWritable(seasonId)
            && request.resource.data.keys().hasOnly(playerPrivateKeys().concat(['privacySplit']));
          allow delete: if ownsSeason(seasonId) && seasonOpen(seasonId);
        }
      }

      match /games/{gameId} {
        allow read: if ownsSeason(seasonId) || publishedSeason(seasonId);
        allow write: if ownsSeasonAfter(seasonId) && acceptsRecords(seasonId);
        match /lines/{lineId} {
          allow read: if ownsSeason(seasonId) || publishedSeason(seasonId);
          allow write: if ownsSeasonAfter(seasonId) && acceptsRecords(seasonId);
        }
      }

      match /lineups/{lineupId} {
        allow read: if ownsSeason(seasonId) || publishedSeason(seasonId);
        allow write: if ownsSeasonAfter(seasonId) && acceptsRecords(seasonId);
      }
    }
  }
}
